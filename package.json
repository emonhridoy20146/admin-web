{
  "name": "admin-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:mock": "NEXT_PUBLIC_API_MOCK=1 next dev -p 3000",
    "build": "next build",
    "build:mock": "NEXT_PUBLIC_API_MOCK=1 next build",
    "serve": "node scripts/serve-static.mjs",
    "gen:api": "openapi-typescript ${FIELD_API_OPENAPI:-./contract/openapi.yaml} -o src/shared/api/schema.d.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "check:permissions": "node scripts/check-permissions.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "new:feature": "node scripts/new-feature.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/noto-sans-bengali": "5.3.0",
    "@radix-ui/react-checkbox": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.0",
    "@radix-ui/react-select": "^2.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.0",
    "@tanstack/react-query": "^5.60.0",
    "@tanstack/react-table": "^8.20.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "i18next": "^24.0.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.460.0",
    "luxon": "^3.5.0",
    "next": "15.5.29",
    "openapi-fetch": "^0.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.1.0",
    "react-leaflet": "^5.0.0",
    "recharts": "^2.15.0",
    "sonner": "^1.7.0",
    "tailwind-merge": "^2.5.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@types/leaflet": "^1.9.14",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.16.0",
    "eslint-config-next": "15.5.29",
    "eslint-plugin-boundaries": "^5.0.0",
    "jsdom": "^25.0.0",
    "msw": "^2.7.0",
    "openapi-typescript": "^7.4.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "yaml": "^2.6.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "msw",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}