# Names only — no secrets belong in this app (everything NEXT_PUBLIC_* ships to the browser).
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_VERSION=
NEXT_PUBLIC_SENTRY_DSN=
# 1 = in-browser MSW mock of the field-api contract (no backend needed)
NEXT_PUBLIC_API_MOCK=
# Build-time path/URL of field-api openapi.yaml for `pnpm gen:api`
FIELD_API_OPENAPI=./contract/openapi.yaml
